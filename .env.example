# Paste your deployed backend URL here (no trailing slash).
# On Vercel, set this as an Environment Variable named NEXT_PUBLIC_BACKEND_URL.
NEXT_PUBLIC_BACKEND_URL=https://trinetra-backend-tukc.onrender.com

# Pravesh (IPO tab) — optional. Raw URL of the pravesh-engine snapshot.
# Unset = the engine repo's committed data/latest.json on GitHub.
# NEXT_PUBLIC_* is inlined at build time, so redeploy after changing it.
# NEXT_PUBLIC_PRAVESH_DATA_URL=https://raw.githubusercontent.com/hardik-goel/pravesh-engine/master/data/latest.json

# Pravesh via Supabase instead of the JSON file (both required to take effect).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_PRAVESH_LATEST_TABLE=pravesh_latest
